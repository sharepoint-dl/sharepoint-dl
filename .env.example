# ══════════════════════════════════════════════════════════════
# OneDrive & SharePoint Public Folder Sync — configuration
#
# Copy this file to ".env", then edit the values.
#   cp .env.example .env
# Lines starting with '#' are comments. Keep them for reference.
# Every toggle below is validated; a wrong value stops the sync
# with a clear error instead of doing something unexpected.
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# 1) SHAREPOINT_URL  (REQUIRED — no default)
#    Public *folder* link, shared as "Anyone with the link can view".
#    Accepted forms:
#      https://1drv.ms/f/s!xxxxxxxx?e=xxxx
#      https://tenant-my.sharepoint.com/:f:/g/personal/<user>/<id>?e=xxxx
#    NOT accepted (will fail with a clear error):
#      - a link to a single FILE (must be a folder link)
#      - a link that requires a Microsoft login
#      - an empty value or a non-http value
# ──────────────────────────────────────────────────────────────
SHAREPOINT_URL=https://tenant-my.sharepoint.com/:f:/g/personal/example/EXAMPLE?e=EXAMPLE


# ──────────────────────────────────────────────────────────────
# 2) DOWNLOAD_DIR  (default: "Download")
#    Where files are saved. Relative values are resolved from the
#    folder that contains this .env file:
#      DOWNLOAD_DIR=Download        → <env-folder>/Download
#      DOWNLOAD_DIR=./backups/team  → <env-folder>/backups/team
#      DOWNLOAD_DIR=/absolute/path  → /absolute/path
#    The folder (and any parent folders) is created automatically.
#    A sub-folder is created per remote sub-folder, files land at
#    the same relative paths as the share.
# ──────────────────────────────────────────────────────────────
DOWNLOAD_DIR=./Download


# ──────────────────────────────────────────────────────────────
# 3) MIRROR_DELETE  (default: true)
#    Whether the destination is an exact mirror of the share.
#
#    true  = EXACT MIRROR. Any file in DOWNLOAD_DIR that is NOT in
#            the share is DELETED. That includes files you or other
#            software created there. Preserved conflict copies
#            (see CONFLICT_MODE=keep_both) are never deleted.
#            Use ONLY when DOWNLOAD_DIR is dedicated to this sync.
#    false = ADDITIVE BACKUP. Nothing is ever deleted; the sync only
#            downloads and updates files that come from the share.
#
#    SAFETY: before the first real run, always preview with:
#        python3 sharepoint_public_sync.py --dry-run
#    Override per-run without touching .env:
#        python3 sharepoint_public_sync.py --no-delete
# ──────────────────────────────────────────────────────────────
MIRROR_DELETE=true


# ──────────────────────────────────────────────────────────────
# 4) CONFLICT_MODE  (default: latest)
#    What to do when a local file exists but does NOT match the
#    version the tool last downloaded from the share (the local
#    file has a different size, or the cloud copy was updated).
#    It fires whenever a local file exists but does not match the
#    recorded version — including pre-existing files on the very
#    first run (no version is recorded yet). Missing files are
#    always downloaded and up-to-date files are always skipped.
#
#    latest   = KEEP THE NEWEST. The local file's modification time
#               is compared with the cloud's last-modified date:
#                 - cloud newer            → download, overwrite local
#                 - local newer            → keep local, no download
#                 - cloud date unavailable → keep local (never risk
#                                            losing a local edit)
#
#    cloud    = ALWAYS CLOUD. Download the cloud copy and overwrite
#               the local file every time. Local edits are lost.
#               Use for a strict, deterministic mirror.
#
#    keep_both = KEEP BOTH. For each conflicting local file:
#                 1) local file is renamed to
#                    "<name>-modified_locally.<ext>"
#                    (if that name is taken, a counter is appended:
#                     report-modified_locally.pdf,
#                     report-modified_locally-1.pdf, ...)
#                 2) the cloud copy is downloaded under the ORIGINAL
#                    name, so both versions coexist.
#               Renamed copies are never deleted, even when
#               MIRROR_DELETE=true, and are kept across runs.
#
#    Values are case-insensitive (LATEST / Cloud / KEEP_BOTH work).
# ──────────────────────────────────────────────────────────────
CONFLICT_MODE=latest


# ──────────────────────────────────────────────────────────────
# 5) TIMEOUT_SECONDS  (default: 90)
#    Seconds to wait for each SharePoint request before the retry
#    logic kicks in (network delays and Microsoft throttling).
#    Increase for slow connections or very large files.
#    Must be a positive integer (e.g. 90, 120, 300).
# ──────────────────────────────────────────────────────────────
TIMEOUT_SECONDS=90